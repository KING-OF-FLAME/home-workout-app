{
  "name": "home-workout-app",
  "version": "1.4.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "validate-data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-resolve.mjs scripts/validate-data.mjs",
    "icons": "python3 scripts/generate-icons.py",
    "check": "npm run typecheck && npm run validate-data"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.1.0",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.15",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.6",
    "expo-notifications": "~58.1.10",
    "expo-router": "~58.0.33",
    "expo-sharing": "~58.0.24",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "firebase": "^13.4.0",
    "pako": "^3.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-body-highlighter": "^3.2.0",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-qrcode-svg": "^6.3.56",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-tcp-socket": "^6.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.2",
    "typescript": "~5.9"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
